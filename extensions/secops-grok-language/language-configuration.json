{
  "comments": {
    "lineComment": {
      "comment": "#"
    }
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    },
    {
      "open": "`",
      "close": "`"
    },
    {
      "open": "%{",
      "close": "}"
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "`",
      "`"
    ],
    [
      "%{",
      "}"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{[^}\"']*$|^\\s*(if|else\\s+if|else|for)\\b.*$",
    "decreaseIndentPattern": "^\\s*(\\}|else\\b|else\\s+if\\b).*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*#?\\s*#region\\b",
      "end": "^\\s*#?\\s*#endregion\\b"
    }
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|(@?[a-zA-Z_][a-zA-Z0-9_.]*)"
}
