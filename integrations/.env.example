# Google SecOps SOAR Integration Deployment Configuration
# Copy this file to .env and fill in your tenant details:
#   cp .env.example .env

# Google Cloud Project ID where Google SecOps is provisioned
SECOPS_PROJECT_ID=your-gcp-project-id

# Google SecOps Location / Region (e.g., europe, us, asia-southeast1)
SECOPS_LOCATION=europe

# Google SecOps Instance ID (UUID or customer ID)
SECOPS_INSTANCE_ID=your-secops-instance-uuid

# Optional: Path to Google Cloud Service Account JSON Key file
# If omitted or empty, Application Default Credentials (ADC) / gcloud auth will be used.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Optional: Set to true if deploying in staging mode (default: false)
# SECOPS_STAGING=false
